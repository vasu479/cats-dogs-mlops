# ---------------------------------------------------------------------------
# Windows CRLF safety.
#
# Without this, Git for Windows checks out shell scripts and Dockerfiles with
# CRLF line endings. The Linux container then fails with errors like
#   "exec /usr/bin/sh: no such file or directory"
# which is one of the most common and most confusing Docker-on-Windows failures.
# Forcing LF for everything the container executes eliminates that class of bug.
# ---------------------------------------------------------------------------

*               text=auto eol=lf

*.ps1           text eol=crlf
*.bat           text eol=crlf
*.cmd           text eol=crlf

*.py            text eol=lf
*.sh            text eol=lf
*.yml           text eol=lf
*.yaml          text eol=lf
Dockerfile      text eol=lf
*.dockerfile    text eol=lf
.dockerignore   text eol=lf
*.md            text eol=lf
*.txt           text eol=lf

*.pt            binary
*.pth           binary
*.h5            binary
*.pkl           binary
*.png           binary
*.jpg           binary
*.jpeg          binary
*.zip           binary
